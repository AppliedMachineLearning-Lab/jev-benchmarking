# Copy to .env (or .env.local for machine-specific overrides) and fill in. Both are git-ignored.
# Values already set in your shell take precedence; .env.local overrides .env.

# TypeSafe API key for Jev (alternatively: a key file, see TYPESAFE_API_KEY_FILE)
TYPESAFE_API_KEY=

# Optional: hard cap on total Jev spend recorded in cache/responses.db (USD)
# JEV_TOTAL_BUDGET_USD=10.40

# Optional: where `alfworld-download` put the ALFWorld games (default ~/.cache/alfworld)
# ALFWORLD_DATA=

# Reserved for a future OpenRouter backend (not used yet)
# OPENROUTER_API_KEY=
